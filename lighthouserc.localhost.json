{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4000/",
        "http://127.0.0.1:4000/login",
        "http://127.0.0.1:4000/festivals"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "chromeFlags": "--no-sandbox --headless=new",
        "budgetPath": "./lighthouse-budget.json"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "uses-long-cache-ttl": "off",
        "csp-xss": "off",
        "unused-javascript": [
          "warn",
          {
            "maxLength": 3
          }
        ],
        "unused-css-rules": [
          "warn",
          {
            "maxLength": 3
          }
        ],
        "is-on-https": "off",
        "redirects-http": "off",
        "uses-http2": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-reports"
    }
  }
}
