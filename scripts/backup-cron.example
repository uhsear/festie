# ──────────────────────────────────────────────────────────────────────────────
# Festie crontab entries
#
# Install: crontab -e  (then paste the lines below)
# Verify:  crontab -l
#
# All scripts log to $APP_DIR/logs/. Create the directory first:
#   mkdir -p /opt/festie/logs
#
# Adjust APP_DIR to your deployment path.
# ──────────────────────────────────────────────────────────────────────────────

APP_DIR=/opt/festie

# ── Database backups ─────────────────────────────────────────────────────────

# On-host dump every 6 hours (pg_dump custom format, 30-day daily + 12 weekly)
0 */6 * * * cd $APP_DIR && bash scripts/backup-pg.sh >> logs/backup.log 2>&1

# Off-site encrypted push to the private backups repo, daily at 1:30 AM
# Needs BACKUP_GPG_PASSPHRASE in .env.
30 1 * * * cd $APP_DIR && bash scripts/backup-offsite-git.sh >> logs/backup-offsite.log 2>&1

# Weekly restore drill from the off-site repo, Sunday 4:00 AM
# Needs ~/.config/festie-drill-db.env (see the script header)
# backup-verify.sh is not scheduled: the drill replaced it.
0 4 * * 0 cd $APP_DIR && bash scripts/backup-restore-drill.sh >> logs/backup-restore-drill.log 2>&1

# Hourly dump plus off-site push. Scheduled always; the script does nothing
# until ~/.festie-festival-mode exists.
20 * * * * cd $APP_DIR && bash scripts/backup-festival-hourly.sh >> logs/backup-festival.log 2>&1

# ── Health monitoring ────────────────────────────────────────────────────────

# Health check every 5 minutes (alerts via webhook, auto-restarts after 3 fails)
*/5 * * * * cd $APP_DIR && bash scripts/health-check.sh >> logs/health-check.log 2>&1

# Error rate alerting every 5 minutes (checks PM2 error logs + /api/health)
*/5 * * * * cd $APP_DIR && node scripts/error-rate-alert.cjs >> logs/alert.log 2>&1

# Metrics rollup hourly (persists in-memory metrics to PostgreSQL)
0 * * * * cd $APP_DIR && node scripts/metrics-rollup.js >> logs/metrics-rollup.log 2>&1

# ── Maintenance ──────────────────────────────────────────────────────────────

# Audit log cleanup: 1st of each month at 4:17 AM (prune rows older than 90d)
17 4 1 * * cd $APP_DIR && bash scripts/audit-log-cleanup.sh >> logs/audit-log-cleanup.log 2>&1

# Application log cleanup daily at 5:00 AM (rotate deploy.log, migrate.log)
0 5 * * * cd $APP_DIR && bash scripts/log-cleanup.sh >> logs/log-cleanup.log 2>&1
