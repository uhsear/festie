# ──────────────────────────────────────────────────────────────────────────────
# Festie crontab entries (mirrors the live crontab; every hc-ping UUID is a placeholder)
#
# Install: crontab -e  (then paste the lines below)
# Verify:  crontab -l
#
# All scripts log to $APP_DIR/logs/. Create the directory first:
#   mkdir -p /opt/festie/logs
#
# Adjust APP_DIR to your deployment path.
#
# Healthchecks.io: create one check per pinged job and replace each <uuid> below.
# Every pinged job ends with `&& curl ... https://hc-ping.com/<uuid>`, so the ping fires
# only when the job exits 0. The hourly festival-mode backup is not pinged: it does
# nothing outside a festival.
# Secrets and addresses (BACKUP_GPG_PASSPHRASE, BACKUP_GIT_REPO, ALERT_WEBHOOK_URL) live in
# $APP_DIR/.env or the cron environment, never in this file.
# ──────────────────────────────────────────────────────────────────────────────

APP_DIR=/opt/festie

# ── Database backups ─────────────────────────────────────────────────────────

# On-host dump every 6 hours (pg_dump custom format, encrypted with BACKUP_GPG_PASSPHRASE; 30-day daily + 12 weekly, nothing older than 13 weeks).
# The same run writes avatars_YYYYMMDD.tar.gz beside the dump (on host only; restore steps in the script header).
0 */6 * * * cd $APP_DIR && bash scripts/backup-pg.sh >> logs/backup.log 2>&1 && curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/<uuid>

# Off-site encrypted push to the private backups repo, daily at 1:30 AM
# Needs BACKUP_GPG_PASSPHRASE and BACKUP_GIT_REPO (the private repo's SSH address) in .env.
30 1 * * * cd $APP_DIR && bash scripts/backup-offsite-git.sh >> logs/backup-offsite.log 2>&1 && curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/<uuid>

# Weekly restore drill from the off-site repo, Sunday 4:00 AM
# Needs ~/.config/festie-drill-db.env (see the script header). The script pings
# DRILL_HEALTHCHECK_URL itself on success, so this line has no curl suffix.
# backup-verify.sh is not scheduled: the drill replaced it.
0 4 * * 0 cd $APP_DIR && DRILL_HEALTHCHECK_URL=https://hc-ping.com/<uuid> bash scripts/backup-restore-drill.sh >> logs/backup-restore-drill.log 2>&1

# Hourly dump plus off-site push, at :20. Scheduled always; the script does nothing
# until ~/.festie-festival-mode exists. Not pinged.
20 * * * * cd $APP_DIR && bash scripts/backup-festival-hourly.sh >> logs/backup-festival.log 2>&1

# ── Monitoring ───────────────────────────────────────────────────────────────

# Error rate alerting every 5 minutes (error rate, memory, disk and /api/ready;
# alerts via ALERT_WEBHOOK_URL)
*/5 * * * * cd $APP_DIR && node scripts/error-rate-alert.cjs >> logs/alert.log 2>&1 && curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/<uuid>

# Metrics rollup hourly (persists in-memory metrics to PostgreSQL)
0 * * * * cd $APP_DIR && node scripts/metrics-rollup.js >> logs/metrics-rollup.log 2>&1 && curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/<uuid>

# Nightly Lighthouse CI run against the public site, 2:17 AM
17 2 * * * cd $APP_DIR && bash scripts/lhci-run.sh >> logs/lhci-nightly.log 2>&1 && curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/<uuid>

# Nightly E2E smoke run, 3:30 AM
30 3 * * * cd $APP_DIR && bash scripts/e2e-nightly.sh >> logs/e2e-nightly.log 2>&1 && curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/<uuid>

# Optional, not on the live crontab: liveness check every 5 minutes (alerts via webhook,
# auto-restarts after 3 fails). Add it only if nothing else restarts a hung process.
# */5 * * * * cd $APP_DIR && bash scripts/health-check.sh >> logs/health-check.log 2>&1

# ── Maintenance ──────────────────────────────────────────────────────────────

# Application log cleanup daily at 3:00 AM (rotate deploy.log, migrate.log)
0 3 * * * cd $APP_DIR && bash scripts/log-cleanup.sh >> logs/log-cleanup.log 2>&1 && curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/<uuid>

# Spotify data refresh daily at 3:30 AM: re-reads artist photos and genres older than 30 days
# (Spotify Developer Terms IV.3.1.1). Needs SPOTIFY_CLIENT_ID and SPOTIFY_CLIENT_SECRET in .env.
30 3 * * * cd $APP_DIR && node --import tsx/esm scripts/spotify-refresh-stale.ts >> logs/spotify-refresh.log 2>&1

# Audit log cleanup: 1st of each month at 2:15 AM (prune rows older than 90d)
15 2 1 * * cd $APP_DIR && bash scripts/audit-log-cleanup.sh >> logs/audit-log-cleanup.log 2>&1 && curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/<uuid>

# Rotate the cron job logs daily at 4:00 AM. Copy logrotate.d/festie.conf to
# ~/.config/logrotate-festie.conf and replace /path/to/festie first (see its header).
0 4 * * * /usr/sbin/logrotate -s $HOME/.config/logrotate-festie.state ~/.config/logrotate-festie.conf >> $APP_DIR/logs/logrotate.log 2>&1 && curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/<uuid>
