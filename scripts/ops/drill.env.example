# Environment for the R1 full restore drill: boot dist/server.js on loopback against
# a restored copy. No secrets. Boot with `env -i` plus this file so the process
# carries no production service credentials. scripts/backup-restore-drill.sh
# refuses to run when any of the five empty keys below is set in its environment.
PORT=4101
REDIS_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
RESEND_API_KEY=
VAPID_PRIVATE_KEY=
FCM_RETRY_WEBHOOK_URL=
SENTRY_DSN=
