{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "lib/avatar-worker.ts",
    "lib/instrument.ts",
    "scripts/*.{mjs,js}",
    "scripts/artist-backfill.ts",
    "scripts/staging/*.ts",
    "tests/**/*.test.ts"
  ],
  "project": ["lib/**/*.ts", "routes/**/*.ts", "scripts/**/*.{ts,mjs,js}"],
  "ignore": ["packages/**"],
  "ignoreIssues": {
    "lib/spotify.ts": ["exports"]
  },
  "ignoreDependencies": ["@sentry/node", "papaparse", "@types/papaparse"],
  "ignoreBinaries": ["expo", "lhci", "psql", "pmtiles", "build-storybook", "bundlemon"]
}
